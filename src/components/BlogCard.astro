---
import { getLangFromUrl, useTranslations } from "../i18n/translations";

const { post } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === "es" ? "" : `/${lang}`;

const currentTitle = lang === "en" ? (post.data.title_en || post.data.title) : post.data.title;
const currentDescription = lang === "en" ? (post.data.description_en || post.data.description) : post.data.description;
---

<article class="blog-card glass-card fade-in-up">
  <a href={`${prefix}/blogs/${post.id}`}>
    <div class="card-content">
      <div class="card-meta">
        <time
          datetime={post.data.pubDate.toISOString()}
        >
          {post.data.pubDate.toLocaleDateString(
            t("blog.locale") as string,
            {
              year: "numeric",
              month: "long",
              day: "numeric",
            },
          )}
        </time>
      </div>
      <h2 class="card-title">
        {currentTitle}
      </h2>
      <p class="card-desc">
        {currentDescription}
      </p>
      <span class="btn">{t("blog.readMore")}</span>
    </div>
  </a>
</article>