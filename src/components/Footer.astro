---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="container footer-content">
        <div class="footer-col">
            <h3 class="footer-title">Farmacia ortopedia Albiñana</h3>
            <p>Cuidando de ti cada día.</p>
        </div>
        <div class="footer-col">
            <p>
                &copy; {currentYear} Farmacia ortopedia Albiñana. Todos los derechos
                reservados.
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--color-primary);
        color: #fff;
        padding: var(--spacing-xl) 0;
        margin-top: 0; /* Removing large margin-top for tighter look */
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-lg);
    }

    .footer-title {
        font-size: 1.5rem;
        margin-bottom: 0.25rem;
        color: #fff;
        letter-spacing: -0.04em;
    }

    .footer p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
    }

    @media (max-width: 768px) {
        .footer-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
