---
interface Props {
    id: string;
    title: string;
    price: number;
    discountPrice?: number;
    description: string;
    imagenes?: string[];
    offerEnds?: Date | string | null;
}

const { id, title, price, discountPrice, description, imagenes, offerEnds } = Astro.props;

const mainImage = imagenes?.[0];
const savingsPercent = discountPrice
    ? Math.round(((price - discountPrice) / price) * 100)
    : null;

const savings = discountPrice ? (price - discountPrice).toFixed(2) : null;

// Convert offerEnds to Date if it's a string, or just use as Date
const offerEndsDate = offerEnds instanceof Date ? offerEnds : (offerEnds ? new Date(offerEnds) : null);
const formattedOfferEnds = offerEndsDate
    ? offerEndsDate.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
    : null;
---

<a href={`${import.meta.env.BASE_URL}/products/${id}`} class="product-card fade-in">
    <div class="card-image-wrap">
        {mainImage ? (
            <img
                src={`${import.meta.env.BASE_URL}${mainImage}`}
                alt={title}
                class="card-image"
            />
        ) : (
            <div class="card-image-placeholder">Sin imagen</div>
        )}
        {savingsPercent && (
            <span class="badge-discount">-{savingsPercent}%</span>
        )}
    </div>

    <div class="card-content">
        <h3 class="product-title">{title}</h3>
        <p class="product-desc">{description}</p>
        <div class="price-container">
            {
                discountPrice ? (
                    <>
                        <span class="original-price">{price.toFixed(2)}€</span>
                        <span class="discount-price">
                            {discountPrice.toFixed(2)}€
                        </span>
                        <span class="savings-tag">Ahorras {savings}€</span>
                    </>
                ) : (
                    <span class="price">{price.toFixed(2)}€</span>
                )
            }
        </div>
        
        {formattedOfferEnds && (
            <p class="offer-ends">
                <span class="offer-icon">⏳</span> Válida hasta {formattedOfferEnds}
            </p>
        )}
        
        <span class="ver-oferta">Ver oferta →</span>
    </div>
</a>

<style>
    .product-card {
        background: #fff;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
        border: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        color: inherit;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }

    /* Imagen */
    .card-image-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f5f5f5;
        margin: var(--spacing-lg) var(--spacing-lg) 0 var(--spacing-lg);
        border-radius: calc(var(--border-radius) - 4px);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-card:hover .card-image {
        transform: scale(1.05);
    }

    .card-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 0.9rem;
    }

    .badge-discount {
        position: absolute;
        top: var(--spacing-sm);
        left: var(--spacing-sm);
        background: #e74c3c;
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
    }

    /* Contenido */
    .card-content {
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .product-title {
        font-size: 1.2rem;
        margin-bottom: var(--spacing-sm);
        color: var(--color-text);
    }

    .product-desc {
        color: #666;
        margin-bottom: var(--spacing-md);
        font-size: 0.9rem;
        flex-grow: 1;
        line-height: 1.5;
    }

    .price-container {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-sm);
    }

    .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 1rem;
    }

    .discount-price {
        color: #e74c3c;
        font-weight: 700;
        font-size: 1.4rem;
    }

    .price {
        color: var(--color-text);
        font-weight: 700;
        font-size: 1.4rem;
    }

    .savings-tag {
        background: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: var(--spacing-sm);
    }

    .offer-ends {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: var(--spacing-sm);
    }

    .offer-icon {
        margin-right: 0.2rem;
    }

    .ver-oferta {
        color: var(--color-primary-dark);
        font-weight: 600;
        font-size: 0.9rem;
        margin-top: auto;
    }
</style>
