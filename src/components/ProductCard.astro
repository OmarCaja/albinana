---
interface Props {
    id: string;
    title: string;
    price: number;
    discountPrice?: number;
    description: string;
    imagenes?: string[];
    offerEnds?: Date | string | null;
    animate?: boolean;
}

const { id, title, price, discountPrice, description, imagenes, offerEnds, animate = false } = Astro.props;



const mainImage = imagenes?.[0];
const savingsPercent = discountPrice
    ? Math.round(((price - discountPrice) / price) * 100)
    : null;

const savings = discountPrice ? (price - discountPrice).toFixed(2) : null;

// Convert offerEnds to Date if it's a string, or just use as Date
const offerEndsDate = offerEnds instanceof Date ? offerEnds : (offerEnds ? new Date(offerEnds) : null);
const formattedOfferEnds = offerEndsDate
    ? offerEndsDate.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
    : null;
---

<a href={`${import.meta.env.BASE_URL}/products/${id}`} class={`product-card glass-card ${animate ? 'fade-in-up' : ''}`}>
    <div class="card-image-wrap">
        {mainImage ? (
            <img
                src={`${import.meta.env.BASE_URL}${mainImage}`}
                alt={title}
                class="card-image"
            />
        ) : (
            <div class="card-image-placeholder">Sin imagen</div>
        )}
        {savingsPercent && (
            <span class="badge-discount">-{savingsPercent}%</span>
        )}
    </div>

    <div class="card-content">
        <h3 class="product-title">{title}</h3>
        <p class="product-desc">{description}</p>
        <div class="price-container">
            {
                discountPrice ? (
                    <>
                        <span class="original-price">{price.toFixed(2)}€</span>
                        <span class="discount-price">
                            {discountPrice.toFixed(2)}€
                        </span>
                        <span class="savings-tag">Ahorras {savings}€</span>
                    </>
                ) : (
                    <span class="price">{price.toFixed(2)}€</span>
                )
            }
        </div>
        
        {formattedOfferEnds && (
            <p class="offer-ends">
                <span class="offer-icon">⏳</span> Válida hasta {formattedOfferEnds}
            </p>
        )}
        
        <span class="btn">Ver oferta →</span>
    </div>
</a>

<style>
    .product-card {
        padding: 0;
        text-decoration: none;
        color: inherit;
    }

    /* Imagen */
    .card-image-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: transparent;
        width: 100%;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 0.9rem;
    }

    .product-title {
        font-size: 1.15rem;
        color: var(--color-primary);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-bottom: var(--spacing-xs);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.4em;
    }

    .product-desc {
        color: var(--color-text-light);
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: var(--spacing-sm);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .price-container {
        display: flex;
        align-items: baseline;
        gap: var(--spacing-xs);
        margin-top: var(--spacing-sm);
        padding-top: 0;
        flex-wrap: wrap;
    }


    .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 0.8rem;
    }

    .discount-price {
        color: var(--color-danger);
        font-weight: 800;
        font-size: 1.3rem;
        letter-spacing: -0.02em;
    }

    .price {
        color: var(--color-text);
        font-weight: 800;
        font-size: 1.3rem;
        letter-spacing: -0.02em;
    }

    .savings-tag {
        background: var(--color-accent-soft);
        color: var(--color-accent);
        padding: 0.15rem 0.4rem;
        border-radius: var(--border-radius-sm);
        font-size: 0.65rem;
        font-weight: 700;
        margin-left: auto;
        border: 1px solid rgba(96, 165, 250, 0.2);
    }

    @media (max-width: 480px) {
        .discount-price, .price {
            font-size: 1.1rem;
        }
        
        .savings-tag {
            margin-left: 0;
            width: 100%;
            text-align: center;
            margin-top: 2px;
        }
    }


    .offer-ends {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: var(--spacing-xs);
    }

    .btn {
        margin-top: var(--spacing-md);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.6rem 1rem;
        border-radius: var(--border-radius-sm);
        font-weight: 600;
        font-size: 0.9rem;
        background: var(--color-primary);
        color: white !important;
    }
</style>




