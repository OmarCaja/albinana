---
interface Props {
    id: string;
    title: string;
    price: number;
    discountPrice?: number;
    description: string;
    imagenes?: string[];
    offerEnds?: Date | string | null;
    animate?: boolean;
}

const { id, title, price, discountPrice, description, imagenes, offerEnds, animate = false } = Astro.props;



const mainImage = imagenes?.[0];
const savingsPercent = discountPrice
    ? Math.round(((price - discountPrice) / price) * 100)
    : null;

const savings = discountPrice ? (price - discountPrice).toFixed(2) : null;

// Convert offerEnds to Date if it's a string, or just use as Date
const offerEndsDate = offerEnds instanceof Date ? offerEnds : (offerEnds ? new Date(offerEnds) : null);
const formattedOfferEnds = offerEndsDate
    ? offerEndsDate.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
    : null;
---

<a href={`${import.meta.env.BASE_URL}/products/${id}`} class={`product-card glass-card ${animate ? 'fade-in-up' : ''}`}>
    <div class="card-image-wrap">
        {mainImage ? (
            <img
                src={`${import.meta.env.BASE_URL}${mainImage}`}
                alt={title}
                class="card-image"
            />
        ) : (
            <div class="card-image-placeholder">Sin imagen</div>
        )}
        {savingsPercent && (
            <span class="badge-discount">-{savingsPercent}%</span>
        )}
    </div>

    <div class="card-content">
        <h3 class="product-title">{title}</h3>
        <p class="product-desc">{description}</p>
        <div class="price-container">
            {
                discountPrice ? (
                    <>
                        <span class="original-price">{price.toFixed(2)}€</span>
                        <span class="discount-price">
                            {discountPrice.toFixed(2)}€
                        </span>
                        <span class="savings-tag">Ahorras {savings}€</span>
                    </>
                ) : (
                    <span class="price">{price.toFixed(2)}€</span>
                )
            }
        </div>
        
        {formattedOfferEnds && (
            <p class="offer-ends">
                <span class="offer-icon">⏳</span> Válida hasta {formattedOfferEnds}
            </p>
        )}
        
        <span class="btn">Ver oferta →</span>
    </div>
</a>

<style>
    .product-card {
        overflow: hidden;
        display: flex;
        flex-direction: column;
        color: inherit;
        height: 100%;
        width: 100%;
        box-shadow: var(--shadow-subtle);
    }

    /* Imagen */
    .card-image-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: transparent;
        flex-shrink: 0;
        width: 100%;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 0.9rem;
    }

    .badge-discount {
        position: absolute;
        top: var(--spacing-md);
        left: var(--spacing-md);
        background: var(--color-danger);
        color: #fff;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    /* Contenido */
    .card-content {
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: var(--spacing-md);
    }

    @media (max-width: 768px) {
        .card-content {
            padding: var(--spacing-md);
        }
    }

    .product-title {
        font-size: 1.15rem;
        color: var(--color-primary);
        font-weight: 700;
        letter-spacing: -0.02em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.3em;
        margin-bottom: var(--spacing-xs);
    }

    @media (max-width: 768px) {
        .product-title {
            font-size: 0.95rem;
            min-height: 2.2em;
            margin-bottom: 2px;
        }
    }

    .product-desc {
        color: var(--color-text-light);
        font-size: 0.95rem;
        flex-grow: 1;
        line-height: 1.5;
        letter-spacing: -0.01em;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .product-desc {
            display: none;
        }
    }

    .price-container {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 1rem;
    }

    .discount-price {
        color: var(--color-danger);
        font-weight: 700;
        font-size: clamp(1.1rem, 4vw, 1.4rem);
    }

    .price {
        color: var(--color-text);
        font-weight: 700;
        font-size: 1.4rem;
    }

    .savings-tag {
        background: var(--color-accent-soft);
        color: var(--color-accent);
        padding: 0.2rem 0.6rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-left: var(--spacing-sm);
        white-space: nowrap;
    }

    .offer-ends {
        font-size: 0.85rem;
        color: #666;
    }

    .offer-icon {
        margin-right: 0.2rem;
    }

</style>
