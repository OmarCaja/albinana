---
import { useTranslations, type Lang } from "../../i18n/translations";
import { ANNIVERSARY_END } from "../../anniversary";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Lucide icon paths
const badges = [
    {
        key: "anniversary.raffles",
        icon: '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>',
    },
    {
        key: "anniversary.promotions",
        icon: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
    },
    {
        key: "anniversary.events",
        icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
    },
    {
        key: "anniversary.gifts",
        icon: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>',
    },
    {
        key: "anniversary.more",
        icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
    },
] as const;
---

<section
    class="anniversary-section"
    id="aniversario"
    data-anniversary-ends={ANNIVERSARY_END.toISOString()}
>
    <div class="container">
        <div class="glass-card anniversary-card fade-in-up">
            <h2 class="anniversary-title" data-confetti>
                {t("anniversary.title")}
            </h2>
            <p class="anniversary-subtitle">{t("anniversary.subtitle")}</p>
            <p
                class="anniversary-countdown"
                data-countdown
                data-starts-in={t("anniversary.countdown.startsIn")}
                data-starts-tomorrow={t("anniversary.countdown.startsTomorrow")}
                data-days-left={t("anniversary.countdown.daysLeft")}
                data-last-day={t("anniversary.countdown.lastDay")}
                hidden
            >
            </p>

            <ul class="anniversary-badges">
                {
                    badges.map(({ key, icon }) => (
                        <li class="anniversary-badge">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={icon}
                            />
                            {t(key)}
                        </li>
                    ))
                }
            </ul>

            <p class="anniversary-thanks">
                {t("anniversary.thanks")}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="anniversary-heart"
                    data-confetti
                    aria-hidden="true"
                    ><path
                        d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
                    ></path></svg
                >
            </p>
        </div>
    </div>
</section>

<script>
    import { ANNIVERSARY_END, getCountdown } from "../../anniversary";

    // Countdown copy comes from data attributes so it stays in the translations file
    const COUNTDOWN_ATTRS = {
        "anniversary.countdown.startsIn": "startsIn",
        "anniversary.countdown.startsTomorrow": "startsTomorrow",
        "anniversary.countdown.daysLeft": "daysLeft",
        "anniversary.countdown.lastDay": "lastDay",
    } as const;

    // Module state survives ClientRouter navigations but resets on full reload,
    // so the celebration plays on every visit but not when navigating back home
    let celebrated = false;

    function launchConfetti() {
        const canvas = document.createElement("canvas");
        canvas.setAttribute("aria-hidden", "true");
        canvas.style.cssText =
            "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
        document.body.appendChild(canvas);

        const ctx = canvas.getContext("2d")!;
        const dpr = window.devicePixelRatio || 1;
        const w = window.innerWidth;
        const h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.scale(dpr, dpr);

        const accent = getComputedStyle(document.documentElement)
            .getPropertyValue("--color-accent")
            .trim();
        const colors = [accent, "#bce9f8", "#ffffff", "#f5c542"];
        const pieces = Array.from({ length: 300 }, () => ({
            x: Math.random() * w,
            y: -20 - Math.random() * h * 0.5,
            vx: (Math.random() - 0.5) * 3,
            vy: 2 + Math.random() * 4,
            size: 6 + Math.random() * 6,
            angle: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 0.3,
            color: colors[Math.floor(Math.random() * colors.length)],
        }));

        let start: number | undefined;
        const frame = (now: number) => {
            start ??= now;
            ctx.clearRect(0, 0, w, h);
            // Fade out over the last second of a 4s run
            ctx.globalAlpha = Math.max(0, Math.min(1, (4000 - (now - start)) / 1000));
            for (const p of pieces) {
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.05;
                p.angle += p.spin;
                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.angle);
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
                ctx.restore();
            }
            if (now - start < 4000) requestAnimationFrame(frame);
            else canvas.remove();
        };
        requestAnimationFrame(frame);
    }

    // Native smooth scroll is too fast and its speed can't be tuned
    function slowScrollTo(el: HTMLElement, duration = 2200) {
        const from = window.scrollY;
        const to = Math.max(
            0,
            el.getBoundingClientRect().top +
                from -
                (window.innerHeight - el.offsetHeight) / 2,
        );
        let start: number | undefined;
        let cancelled = false;
        // Stop if the visitor starts scrolling on their own
        const cancel = () => (cancelled = true);
        window.addEventListener("wheel", cancel, { once: true });
        window.addEventListener("touchstart", cancel, { once: true });

        const step = (now: number) => {
            if (cancelled) return;
            start ??= now;
            const t = Math.min(1, (now - start) / duration);
            const eased = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
            window.scrollTo(0, from + (to - from) * eased);
            if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
    }

    document.addEventListener("astro:page-load", () => {
        const banner = document.getElementById("aniversario");
        const now = new Date();
        if (!banner || now >= ANNIVERSARY_END) return;

        const countdownEl = banner.querySelector<HTMLElement>("[data-countdown]");
        const countdown = getCountdown(now);
        if (countdownEl && countdown) {
            const template = countdownEl.dataset[COUNTDOWN_ATTRS[countdown.key]] ?? "";
            countdownEl.textContent = template.replace("{n}", String(countdown.n));
            countdownEl.hidden = false;
        }

        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (!reduceMotion) {
            banner
                .querySelectorAll("[data-confetti]")
                .forEach((el) => el.addEventListener("click", launchConfetti));
        }

        if (celebrated) return;
        celebrated = true;

        const celebrate = () => {
            if (reduceMotion) {
                banner.scrollIntoView({ block: "center" });
                return;
            }
            slowScrollTo(banner);
            launchConfetti();
        };

        // Wait until the tab is visible so the animation isn't missed
        if (document.hidden) {
            document.addEventListener("visibilitychange", celebrate, {
                once: true,
            });
        } else {
            celebrate();
        }
    });
</script>

<style>
    .anniversary-section {
        scroll-margin-top: var(--header-height);
        padding: var(--spacing-lg) 0;
        background-color: var(--color-bg);
    }

    .anniversary-card {
        padding: var(--spacing-xl) var(--spacing-lg);
        background: linear-gradient(
            135deg,
            var(--glass-bg),
            rgba(0, 149, 200, 0.08)
        );
        border: 1px solid var(--color-accent-soft);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--spacing-md);
    }

    .anniversary-title {
        font-size: clamp(2.4rem, 7vw, 4rem);
        margin: 0;
        color: var(--color-accent);
        letter-spacing: -0.04em;
        line-height: 1;
        text-shadow: 0 10px 40px rgba(0, 149, 200, 0.2);
    }

    .anniversary-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-light);
        line-height: 1.6;
        margin: 0;
        max-width: 800px;
    }

    .anniversary-countdown {
        display: inline-block;
        padding: var(--spacing-xs) var(--spacing-md);
        border-radius: 999px;
        background: var(--color-accent);
        color: var(--color-surface);
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .anniversary-countdown[hidden] {
        display: none;
    }

    [data-confetti] {
        cursor: pointer;
    }

    .anniversary-badges {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--spacing-sm);
        margin: var(--spacing-sm) 0;
    }

    .anniversary-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: 999px;
        background: var(--color-surface);
        border: 1px solid var(--color-surface-muted);
        color: var(--color-primary);
        font-weight: 600;
        box-shadow: var(--shadow-subtle);
    }

    .anniversary-badge svg {
        color: var(--color-accent);
        flex-shrink: 0;
    }

    .anniversary-thanks {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--color-primary);
        margin: 0;
    }

    .anniversary-heart {
        color: var(--color-accent);
        vertical-align: middle;
        margin-left: var(--spacing-xs);
    }

    @media (max-width: 768px) {
        .anniversary-card {
            padding: var(--spacing-lg);
        }

        .anniversary-subtitle {
            font-size: 1.1rem;
        }
    }
</style>
