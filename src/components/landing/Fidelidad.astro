<section class="fidelity-section">
    <div class="container fidelity-container">
        <div class="glass-card fidelity-card fade-in-up">
            <div class="fidelity-content">
                <div class="fidelity-badge">5%</div>
                <div class="fidelity-text">
                    <h2 class="fidelity-title">Tarjeta de Fidelización</h2>
                    <p class="fidelity-description">
                        Por ser cliente de la farmacia y tener cuenta, acumula
                        un 5%* del importe de tus compras en parafarmacia
                        (excepto alimentación infantil) y descuéntalo en tus
                        próximas compras de parafarmacia.
                    </p>
                    <p class="fidelity-disclaimer">
                        * No aplicable a medicamentos.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .fidelity-section {
        padding: var(--spacing-lg) 0;
        background-color: var(--color-bg);
    }

    .fidelity-card {
        padding: var(--spacing-xl) var(--spacing-lg);
        background: linear-gradient(
            135deg,
            var(--glass-bg),
            rgba(0, 149, 200, 0.05)
        );
        border: 1px solid var(--color-accent-soft);
        display: flex;
        align-items: center;
        width: 100%;
    }

    .fidelity-content {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--spacing-xl);
        max-width: 1100px;
        margin: 0 auto;
    }

    .fidelity-badge {
        font-size: 5rem;
        font-weight: 800;
        color: var(--color-accent);
        line-height: 1;
        letter-spacing: -0.05em;
        text-shadow: 0 10px 40px rgba(0, 149, 200, 0.2);
    }

    .fidelity-text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .fidelity-title {
        font-size: clamp(2rem, 5vw, 2.8rem);
        margin: 0;
        color: var(--color-primary);
        letter-spacing: -0.04em;
    }

    .fidelity-description {
        font-size: 1.25rem;
        color: var(--color-text-light);
        line-height: 1.6;
        margin: 0;
        max-width: 800px;
    }

    .fidelity-disclaimer {
        font-size: 0.9rem;
        color: var(--color-text-muted);
        opacity: 0.7;
    }

    @media (max-width: 768px) {
        .fidelity-card {
            padding: var(--spacing-lg);
        }

        .fidelity-content {
            flex-direction: column;
            text-align: center;
            gap: var(--spacing-lg);
        }

        .fidelity-badge {
            font-size: 4rem;
        }

        .fidelity-description {
            font-size: 1.1rem;
        }
    }
</style>
