<section id="contact" class="section contact-section">
    <div class="container">
        <div class="contact-header fade-in-up">
            <h2 class="page-title">Contacto.</h2>
            <p class="page-subtitle">Estamos aquí para cuidar de ti.</p>
        </div>

        <div class="contact-grid fade-in-up">
            <div class="contact-method">
                <a
                    href="https://www.google.com/maps/search/?api=1&query=Avinguda+del+País+Valencià,+40,+46117+Bétera,+Valencia"
                    target="_blank"
                    class="method-header-link"
                >
                </a>
                <address class="method-val">
                    Avda. País Valencià, 40<br />
                    46117 Bétera, Valencia
                </address>
                <a
                    href="https://www.google.com/maps/search/?api=1&query=Avinguda+del+País+Valencià,+40,+46117+Bétera,+Valencia"
                    target="_blank"
                    class="btn">Ver en Google Maps ↗</a
                >
            </div>

            <div class="contact-method">
                <a href="tel:647892464" class="method-header-link">
                    <div class="method-header">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="method-icon"
                            ><path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path></svg
                        >
                        <span class="method-label">Llámanos</span>
                    </div>
                </a>
                <span class="method-val">647 892 464</span>
            </div>

            <div class="contact-method">
                <a
                    href="https://wa.me/34647892464"
                    target="_blank"
                    class="method-header-link"
                >
                    <div class="method-header">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="method-icon"
                            ><path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                            ></path></svg
                        >
                        <span class="method-label">WhatsApp</span>
                    </div>
                </a>
                <span class="method-val">Chat directo</span>
            </div>

            <div class="contact-method">
                <a
                    href="https://www.instagram.com/farmaciaalbinana_/"
                    target="_blank"
                    class="method-header-link"
                >
                    <div class="method-header">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="method-icon"
                            ><rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"></rect><path
                                d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                            ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                            ></line></svg
                        >
                        <span class="method-label">Instagram</span>
                    </div>
                </a>
                <span class="method-val">Síguenos</span>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-section {
        background-color: var(--color-bg);
        border-top: 1px solid var(--glass-border);
    }

    .contact-header {
        margin-bottom: var(--spacing-xl);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-xl);
    }

    .contact-method {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .method-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        color: var(--color-accent);
        transition: transform 0.2s ease;
    }

    .method-header-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
        margin-bottom: var(--spacing-xs);
    }

    .method-header-link:hover .method-header {
        transform: translateX(4px);
        color: var(--color-primary);
    }

    .method-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-weight: 700;
        opacity: 0.8;
    }

    .method-val {
        font-size: 1.3rem;
        color: var(--color-primary);
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.01em;
        font-style: normal;
        line-height: 1.3;
    }

    .method-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-text-light);
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .method-link:hover {
        color: var(--color-accent);
    }

    .method-meta {
        font-size: 0.85rem;
        color: var(--color-text-light);
        opacity: 0.6;
    }

    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: var(--spacing-lg);
        }

        .method-val {
            font-size: 1.15rem;
        }
    }
</style>
