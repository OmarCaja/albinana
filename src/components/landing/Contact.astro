<section id="contact" class="section contact-section">
    <div class="container">
        <div class="contact-header fade-in-up">
            <h2 class="page-title">Contacto.</h2>
            <p class="page-subtitle">Estamos aquí para cuidar de ti.</p>
        </div>
        
        <div class="contact-grid fade-in-up">
            <div class="contact-block">
                <span class="block-label">Visítanos</span>
                <address class="block-value link-massive">
                    Avda. País Valencià, 40, Bétera
                </address>
                <a href="https://www.google.com/maps/search/?api=1&query=Avinguda+del+País+Valencià,+40,+46117+Bétera,+Valencia" target="_blank" rel="noopener noreferrer" class="btn block-link">Abrir en mapas ↗</a>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-section {
        background-color: var(--color-bg);
        padding: var(--section-padding) 0;
    }

    .contact-header {
        margin-bottom: var(--spacing-xl);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
    }



    .contact-block {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .block-value {
        font-size: 1.1rem;
        color: var(--color-text);
        font-style: normal;
        line-height: 1.4;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: -0.01em;
    }
    
    .link-massive {
        font-size: clamp(1.4rem, 3.5vw, 1.8rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        transition: opacity var(--transition-fast);
        word-break: break-word;
    }
    
    .link-massive:hover {
        opacity: 0.6;
    }

    .block-link {
        margin-top: var(--spacing-sm);
    }
</style>
