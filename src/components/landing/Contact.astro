---

<section id="contact" class="section contact-section">
    <div class="container">
        <div class="contact-header">
            <h2 class="section-title">Contacto.</h2>
            <p class="contact-subtitle">Estamos aquí para cuidar de ti.</p>
        </div>
        
        <div class="contact-grid">
            <div class="contact-block">
                <span class="block-label">Visítanos</span>
                <address class="block-value link-massive">
                    Avinguda del País Valencià, 40, 46117 Bétera, Valencia
                </address>
                <a href="https://www.google.com/maps/search/?api=1&query=Avinguda+del+País+Valencià,+40,+46117+Bétera,+Valencia" target="_blank" rel="noopener noreferrer" class="block-link">Abrir en Mapas ↗</a>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-section {
        background-color: var(--color-surface);
        padding: var(--spacing-xl) 0 calc(var(--spacing-xl) * 2) 0;
    }

    .contact-header {
        margin-bottom: var(--spacing-xl);
    }

    .section-title {
        font-size: clamp(2rem, 6vw, 3.5rem);
        color: var(--color-text);
        margin-bottom: var(--spacing-md);
        letter-spacing: -0.04em;
        line-height: 1.1;
    }

    .contact-subtitle {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        color: var(--color-text-light);
        letter-spacing: -0.02em;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
    }



    .contact-block {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .block-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-light);
        font-weight: 600;
        margin-bottom: var(--spacing-sm);
    }

    .block-value {
        font-size: 1.25rem;
        color: var(--color-text);
        font-style: normal;
        line-height: 1.4;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: -0.01em;
    }
    
    .link-massive {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        transition: opacity var(--transition-fast);
        word-break: break-word;
    }
    
    .link-massive:hover {
        opacity: 0.6;
    }

    .block-link {
        font-size: 1rem;
        color: var(--color-primary-dark);
        font-weight: 500;
        margin-top: var(--spacing-sm);
        transition: opacity var(--transition-fast);
    }
    
    .block-link:hover {
        opacity: 0.6;
    }
</style>
