---
import data from "../../content/ofertas/ofertas.json";
import ProductCard from "../ProductCard.astro";

const offers = data.productos.slice(0, 4);
---

<section class="highlights-section">
    <div class="container highlights-container">
        <div class="header-container">
            <h2 class="page-title fade-in-up">Ofertas Destacadas</h2>
        </div>
        
        <div class="carousel-container fade-in-up">
            <div class="carousel-track" id="carouselTrack">
                {offers.map((offer, index) => (
                    <div class="carousel-item" data-index={index}>
                        <ProductCard
                            id={offer.id}
                            title={offer.title}
                            price={offer.price}
                            discountPrice={offer.discountPrice}
                            description={offer.description}
                            imagenes={offer.imagenes}
                            offerEnds={offer.offerEnds}
                            animate={false}
                        />
                    </div>
                ))}
            </div>
        </div>
    </div>

    <div class="container carousel-controls">
        <div class="carousel-pagination" id="carouselPagination">
            {offers.map((_, index) => (
                <button 
                    class={`pagination-dot ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`Ir a la oferta ${index + 1}`}
                ></button>
            ))}
        </div>
        <div class="carousel-footer-btn">
            <a href={`${import.meta.env.BASE_URL}/products`} class="btn">
                Ver todas las ofertas →
            </a>
        </div>
    </div>
</section>

<script>
    function setupCarousel() {
        const track = document.getElementById('carouselTrack');
        const dots = document.querySelectorAll('.pagination-dot');
        
        if (!track || dots.length === 0) return;

        const observerOptions = {
            root: track,
            threshold: 0.6
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const index = entry.target.getAttribute('data-index');
                    if (index !== null) {
                        updateDots(parseInt(index));
                    }
                }
            });
        }, observerOptions);

        document.querySelectorAll('.carousel-item').forEach(item => {
            observer.observe(item);
        });

        function updateDots(activeIndex: number) {
            dots.forEach((dot, index) => {
                if (index === activeIndex) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        // Add click events to dots
        dots.forEach(dot => {
            dot.addEventListener('click', () => {
                const index = dot.getAttribute('data-index');
                const targetItem = document.querySelector(`.carousel-item[data-index="${index}"]`);
                if (targetItem) {
                    targetItem.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
                }
            });
        });
    }

    // Run on load and after view transitions
    setupCarousel();
    document.addEventListener('astro:page-load', setupCarousel);
</script>

<style>
    .highlights-section {
        padding: var(--section-padding) 0;
        background-color: var(--color-bg);
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .highlights-section {
            /* Inheriting standard --section-padding from above */
        }

        .header-container {
            margin-bottom: var(--spacing-sm);
        }
    }

    .header-container {
        margin-bottom: var(--spacing-md);
    }

    .carousel-container {
        position: relative;
        width: 100%;
        margin-bottom: var(--spacing-md);
    }

    .carousel-track {
        display: flex;
        align-items: stretch;
        gap: var(--spacing-lg);
        overflow-x: auto;
        overflow-y: hidden;
        padding: 20px 0;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        scroll-behavior: smooth;
        touch-action: pan-y;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-item {
        flex: 0 0 350px;
        scroll-snap-align: start;
        display: flex;
        align-self: stretch;
        width: 100%;
    }

    .carousel-item > :global(*) {
        flex: 1;
    }

    @media (max-width: 1024px) {
        .carousel-item {
            flex: 0 0 300px;
        }
    }

    @media (max-width: 768px) {
        .carousel-item {
            flex: 0 0 160px;
        }
        
        .carousel-track {
            padding: 0 var(--spacing-md);
            gap: var(--spacing-sm);
        }
    }

    .carousel-controls {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-lg);
        margin-top: var(--spacing-md);
    }

    @media (min-width: 768px) {
        .carousel-controls {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .carousel-pagination {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    @media (min-width: 1024px) {
        .carousel-controls {
            justify-content: center;
        }
    }

    .pagination-dot {
        width: 12px;
        height: 4px;
        border-radius: 20px;
        background-color: var(--color-surface-muted);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .pagination-dot.active {
        background-color: var(--color-accent);
        width: 32px;
    }
</style>
