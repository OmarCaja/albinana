---
import { languages, getLangFromUrl, getAlternateUrl } from "../i18n/translations";

const currentLang = getLangFromUrl(Astro.url);
---

<div class="lang-selector">
  {Object.entries(languages).map(([lang, { label }]) => {
    const isActive = lang === currentLang;
    const href = getAlternateUrl(Astro.url, lang as keyof typeof languages);
    return (
      <a
        href={href}
        class:list={["lang-btn", { active: isActive }]}
        aria-current={isActive ? "true" : undefined}
        title={label}
        aria-label={label}
      >
        <span class="lang-label">{lang.toUpperCase()}</span>
      </a>
    );
  })}
</div>

<style>
  .lang-selector {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 8px;
  }

  .lang-btn {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-light);
    transition: color 0.3s ease;
    padding: 4px 2px;
    position: relative;
    letter-spacing: 0.05em;
  }

  .lang-btn:hover {
    color: var(--color-primary);
  }

  .lang-btn.active {
    color: var(--color-text);
    font-weight: 700;
  }

  .lang-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }
</style>
