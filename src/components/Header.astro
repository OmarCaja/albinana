---
import HamburgerMenu from "./HamburgerMenu.astro";
import LanguageSelector from "./LanguageSelector.astro";
import { getLangFromUrl } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
---

<header class="header">
    <div class="header-container header-content">
        <a href={lang === "es" ? "/" : "/en"} class="logo-link">
            <img
                src="/favicon.svg"
                alt="Farmacia Ortopedia Albiñana Logo"
                class="logo-img"
            />
        </a>
        <div class="menu-wrapper">
            <LanguageSelector />
            <HamburgerMenu />
        </div>
        <div class="reading-progress" id="readingProgress"></div>
    </div>
</header>

<style>
    .header {
        height: var(--header-height);
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        background: var(--glass-bg);
        backdrop-filter: saturate(180%) blur(var(--glass-blur));
        -webkit-backdrop-filter: saturate(180%) blur(var(--glass-blur));
        border-bottom: 1px solid var(--glass-border);
        transition: background-color var(--transition-fast);
    }

    .reading-progress {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 0%;
        height: 2px;
        background: var(--color-accent);
        transition: width 0.1s ease-out;
    }

    .header-container {
        width: 100%;
        max-width: 1600px; /* Wider than normal container */
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
    }

    @media (min-width: 1024px) {
        .header-container {
            padding: 0 var(--spacing-xl);
        }
    }

    .header-content {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-wrapper {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .logo-img:hover {
        opacity: 0.8;
    }

    .logo-img {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        object-fit: cover;
    }
</style>
