---
import HamburgerMenu from "./HamburgerMenu.astro";
import LanguageSelector from "./LanguageSelector.astro";
import { getLangFromUrl, useTranslations } from "../i18n/translations";
import { ANNIVERSARY_END } from "../anniversary";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const showAnniversaryBar = new Date() < ANNIVERSARY_END;
---

<header class="header">
    <div class="header-container header-content">
        <a href={lang === "es" ? "/" : "/en/"} class="logo-link">
            <img
                src="/favicon.svg"
                alt="Farmacia Ortopedia Albiñana Logo"
                class="logo-img"
                width="30"
                height="30"
            />
        </a>
        <div class="menu-wrapper">
            <LanguageSelector />
            <HamburgerMenu />
        </div>
        <div class="reading-progress" id="readingProgress"></div>
    </div>
    {
        showAnniversaryBar && (
            <a
                href={lang === "es" ? "/anniversary/" : "/en/anniversary/"}
                class="announcement-bar"
                data-anniversary-ends={ANNIVERSARY_END.toISOString()}
            >
                🎉 {t("anniversary.bar")} →
            </a>
        )
    }
</header>

<style>
    .header {
        height: var(--header-height);
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        border-bottom: 1px solid var(--glass-border);
        transition: background-color var(--transition-fast);
        display: flex;
        flex-direction: column;
    }

    /* Blur lives on a pseudo-element: Chrome drops a parent's backdrop-filter
       when a descendant (the menu overlay) also has one. */
    .header::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--glass-bg);
        backdrop-filter: saturate(180%) blur(var(--glass-blur));
    }

    .announcement-bar {
        height: var(--announcement-height);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 var(--spacing-md);
        background: var(--color-accent);
        color: var(--color-surface);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .announcement-bar:hover {
        text-decoration: underline;
    }

    .reading-progress {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 0%;
        height: 2px;
        background: var(--color-accent);
        transition: width 0.1s ease-out;
    }

    .header-container {
        width: 100%;
        max-width: 1600px; /* Wider than normal container */
        margin: 0 auto;
        padding: env(safe-area-inset-top) var(--spacing-lg) 0;
    }

    @media (min-width: 1024px) {
        .header-container {
            padding: env(safe-area-inset-top) var(--spacing-xl) 0;
        }
    }

    .header-content {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-wrapper {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .logo-img:hover {
        opacity: 0.8;
    }

    .logo-img {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        object-fit: cover;
    }
</style>
