---
import HamburgerMenu from "./HamburgerMenu.astro";
---

<header class="header">
    <div class="container header-content">
        <a href={import.meta.env.BASE_URL} class="logo">
            <img
                src={`${import.meta.env.BASE_URL}/favicon.jpeg`}
                alt="Farmacia Albiñana Logo"
                class="logo-img"
            />
            <span class="logo-text">Albiñana</span>
        </a>
        <div class="menu-wrapper">
            <HamburgerMenu />
        </div>
    </div>
</header>

<style>
    .header {
        height: var(--header-height);
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        background: rgba(241, 245, 249, 0.8);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        transition: all var(--transition-fast);
    }

    .header-content {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 1.2rem;
        color: var(--color-text);
        letter-spacing: -0.01em;
    }

    .logo-img {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        object-fit: cover;
    }

    .logo-text {
        color: var(--color-text);
    }
</style>
