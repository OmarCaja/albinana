---
interface Props {
    id: string;
    imagen: string;
}

const { id, imagen } = Astro.props;
---

<div class="brand-card glass-card fade-in-up">
    <div class="card-image-wrap">
        <img src={`${import.meta.env.BASE_URL}${imagen}`} class="card-image" alt={`Marca ${id}`} />
    </div>
</div>

<style>
    .brand-card {
        padding: var(--spacing-lg);
        align-items: center;
        justify-content: center;
    }

    .card-image-wrap {
        width: 100%;
        aspect-ratio: 3 / 2;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--spacing-sm);
    }

    .card-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
</style>



