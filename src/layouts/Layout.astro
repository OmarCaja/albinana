---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { getLangFromUrl, getAlternateUrl, languages } from "../i18n/translations";

interface Props {
    title: string;
    description?: string;
    defaultDescription?: string;
}

const lang = getLangFromUrl(Astro.url);

const {
    title,
    description = lang === "en"
        ? "Farmacia Ortopedia Albiñana - Your trusted pharmacy in Bétera."
        : "Farmacia Ortopedia Albiñana - Tu farmacia de confianza en Bétera.",
} = Astro.props;

// Build alternate URLs for hreflang
const alternateUrls = Object.keys(languages).reduce((acc, l) => {
    acc[l] = new URL(getAlternateUrl(Astro.url, l as keyof typeof languages), Astro.site ?? Astro.url).toString();
    return acc;
}, {} as Record<string, string>);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="Farmacia Albiñana" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={Astro.url} />

        <!-- hreflang alternate links -->
        {Object.entries(alternateUrls).map(([l, url]) => (
            <link rel="alternate" hreflang={l === "es" ? "es-ES" : "en-GB"} href={url} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternateUrls["es"]} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL("/logo.jpg", Astro.url)} />
        <meta property="og:locale" content={lang === "en" ? "en_GB" : "es_ES"} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta
            property="twitter:image"
            content={new URL("/logo.jpg", Astro.url)}
        />

        <!-- Structured Data -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Farmacia Albiñana",
                "alternateName": ["Farmacia Ortopedia Albiñana", "Albiñana"],
                "url": "https://farmaciaalbinana.es"
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Pharmacy",
                "name": "Farmacia Albiñana",
                "image": "https://farmaciaalbinana.es/logo.jpg",
                "@id": "https://farmaciaalbinana.es/",
                "url": "https://farmaciaalbinana.es/",
                "telephone": "+34647892464",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Avda. País Valencià, 40",
                    "addressLocality": "Bétera",
                    "postalCode": "46117",
                    "addressRegion": "Valencia",
                    "addressCountry": "ES"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": 39.5925,
                    "longitude": -0.4578
                },
                "openingHoursSpecification": [
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": [
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday",
                            "Saturday"
                        ],
                        "opens": "09:00",
                        "closes": "21:00"
                    },
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": "Sunday",
                        "opens": "09:00",
                        "closes": "14:00"
                    }
                ],
                "sameAs": [
                    "https://www.instagram.com/farmaciaalbinana_/",
                    "https://wa.me/34647892464"
                ]
            }
        </script>

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
        <ClientRouter />
        <script>
            // Global variables stored in the module scope to persist across navigations
            let currentObserver: IntersectionObserver | null = null;
            let currentScrollHandler:
                | ((this: Window, ev: Event) => any)
                | null = null;

            // Function to setup Intersection Observer for fade-in animations
            function setupObserver() {
                // Ensure we disconnect the old observer before creating a new one
                if (currentObserver) {
                    currentObserver.disconnect();
                }

                currentObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("visible");
                                currentObserver?.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        root: null,
                        rootMargin: "0px 0px -20px 0px", // Trigger slightly before it fully enters
                        threshold: 0.05, // Only 5% needs to be visible
                    },
                );

                // Initialize visibility for all elements that need to animate
                // We do this every time the page loads (initial or navigation)
                document
                    .querySelectorAll(".fade-in-up:not(.visible)")
                    .forEach((el) => {
                        currentObserver?.observe(el);
                    });
            }

            // Function to handle reading progress bar
            function setupReadingProgress() {
                const progressBar = document.getElementById("readingProgress");
                if (!progressBar) return;

                const onScroll = () => {
                    const pixelsScrolled = window.scrollY;
                    const pageHeight =
                        document.documentElement.scrollHeight -
                        window.innerHeight;
                    const scrollPercentage = Math.min(
                        100,
                        (pixelsScrolled / (pageHeight || 1)) * 100,
                    );

                    progressBar.style.width = scrollPercentage + "%";
                };

                // Remove existing listener to avoid duplicates if navigation happens
                if (currentScrollHandler) {
                    window.removeEventListener("scroll", currentScrollHandler);
                }
                currentScrollHandler = onScroll;
                window.addEventListener("scroll", currentScrollHandler, {
                    passive: true,
                });
                onScroll(); // Manual call for initial state
            }

            // Use 'astro:page-load' to ensure scripts run on initial load and navigation
            document.addEventListener("astro:page-load", () => {
                setupObserver();
                setupReadingProgress();
            });
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
