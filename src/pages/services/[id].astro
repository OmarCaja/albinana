---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";

export async function getStaticPaths() {
    const services = await getCollection("services");
    return services.map((service) => ({
        params: { id: service.id },
        props: service,
    }));
}

const service = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === "es" ? "" : `/${lang}`;

const title = lang === "en" ? (service.data.title_en || service.data.title) : service.data.title;
const description = lang === "en" ? (service.data.description_en || service.data.description) : service.data.description;
const content = lang === "en" ? (service.data.content_en || service.data.content) : service.data.content;
const { icon } = service.data;
---

<Layout
    title={`${title} | Farmacia Ortopedia Albiñana`}
    description={description}
>
    <Header />
    <main class="post-page">
        <div class="container">
            <nav class="breadcrumb">
                <a href={`${prefix}/services`} class="btn">{t("services.back")}</a>
            </nav>
            <article class="post-container fade-in-up">
                <header class="post-header">
                    <div class="meta">
                        <span class="service-icon">{icon}</span>
                    </div>
                    <h1 class="page-title">{title}</h1>
                    <p class="page-subtitle">{description}</p>
                </header>

                {content && (
                    <div class="post-content" set:html={content} />
                )}
            </article>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .post-page {
        padding-top: calc(var(--header-height) + 3rem);
        min-height: 80vh;
        background-color: var(--color-bg);
        padding-bottom: var(--section-padding);
    }

    .breadcrumb {
        margin-bottom: var(--spacing-sm);
    }

    .breadcrumb a:hover {
        opacity: 0.8;
    }

    .post-container {
        width: 100%;
        background: transparent;
    }

    .post-header {
        margin-bottom: var(--spacing-md);
        padding-bottom: var(--spacing-sm);
    }

    .meta {
        display: flex;
        gap: var(--spacing-md);
        color: var(--color-text-light);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .service-icon {
        font-size: 2.5rem;
        line-height: 1;
    }

    .post-content {
        line-height: 1.6;
        font-size: clamp(1.1rem, 2.5vw, 1.25rem);
        color: var(--color-text);
        letter-spacing: -0.01em;
    }

    /* Markdown Content Styling */
    .post-content :global(h1),
    .post-content :global(h2),
    .post-content :global(h3) {
        color: var(--color-primary);
        margin-top: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
        letter-spacing: -0.05em;
        font-weight: 700;
    }

    .post-content :global(h2) {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
    }

    .post-content :global(p) {
        margin-bottom: var(--spacing-md);
        color: var(--color-text);
    }

    .post-content :global(ul) {
        list-style: disc;
        margin-left: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }

    .post-content :global(strong) {
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .post-container {
            padding: 0;
        }
    }
</style>
