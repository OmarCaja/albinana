---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = await getCollection("services");

// Sort services by priority (ascending order, so 1 comes first)
const sortedServices = [...services].sort((a, b) => {
	// If priority is not defined, set it to a high number (4) so it appears at the end
	const priorityA = a.data.priority ?? 4;
	const priorityB = b.data.priority ?? 4;
	return priorityA - priorityB;
});
---

<style>
	.grid-services {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	@media (min-width: 1024px) {
		.grid-services {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-xl);
		}
	}
</style>

<Layout
	title={t("services.meta.title")}
	description={t("services.meta.description")}
>
	<Header />
	<main>
		<section class="section-full">
			<div class="container">
				<h1 class="page-title">{t("services.title")}</h1>
				<p class="page-subtitle">
					{t("services.subtitle")}
				</p>

				<div class="grid-services">
					{
						sortedServices.map((service) => (
							<ServiceCard
								id={service.id}
								title={lang === "en" ? (service.data.title_en || service.data.title) : service.data.title}
								description={lang === "en" ? (service.data.description_en || service.data.description) : service.data.description}
								icon={service.data.icon}
							/>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
