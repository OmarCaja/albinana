---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";
import { Image, getImage } from "astro:assets";
import { galleryImages } from "../../gallery";

const fullSizes = await Promise.all(
    galleryImages.map((img) => getImage({ src: img, width: 1600, format: "webp" })),
);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
    title={t("gallery.meta.title")}
    description={t("gallery.meta.description")}
>
    <Header />
    <main id="main-content">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title fade-in-up">{t("gallery.title")}</h1>
                <p class="page-subtitle fade-in-up">{t("gallery.subtitle")}</p>

                <div class="gallery-grid">
                    {
                        galleryImages.map((src, i) => (
                            <button
                                type="button"
                                class="gallery-item glass-card fade-in-up"
                                data-index={i}
                                data-full={fullSizes[i].src}
                                aria-label={t("gallery.open")}
                            >
                                <Image
                                    src={src}
                                    alt={`${t("gallery.alt")} ${i + 1}`}
                                    widths={[400, 800]}
                                    sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
                                    format="webp"
                                    loading={i < 3 ? "eager" : "lazy"}
                                />
                            </button>
                        ))
                    }
                </div>
            </div>
        </section>

        <dialog id="lightbox" class="lightbox">
            <img alt="" />
            <button type="button" class="lightbox-close" aria-label={t("gallery.close")}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
            <button type="button" class="lightbox-nav lightbox-prev" aria-label={t("gallery.prev")}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg></button>
            <button type="button" class="lightbox-nav lightbox-next" aria-label={t("gallery.next")}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg></button>
        </dialog>
    </main>
    <Footer />
</Layout>

<script>
    // Delegated on document: survives ClientRouter navigations without re-binding.
    let current = 0;
    const dialog = () => document.getElementById("lightbox") as HTMLDialogElement | null;
    const items = () => [...document.querySelectorAll<HTMLElement>(".gallery-item")];

    function show(i: number) {
        const list = items();
        current = (i + list.length) % list.length;
        dialog()!.querySelector("img")!.src = list[current].dataset.full!;
    }

    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const d = dialog();
        if (!d) return;
        const item = target.closest<HTMLElement>(".gallery-item");
        if (item) {
            show(Number(item.dataset.index));
            d.showModal();
        } else if (target.closest(".lightbox-prev")) show(current - 1);
        else if (target.closest(".lightbox-next")) show(current + 1);
        else if (target === d || target.closest(".lightbox-close")) d.close();
    });

    document.addEventListener("keydown", (e) => {
        if (!dialog()?.open) return;
        if (e.key === "ArrowLeft") show(current - 1);
        if (e.key === "ArrowRight") show(current + 1);
    });

    // Swipe on touch screens
    let startX = 0;
    document.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX;
    });
    document.addEventListener("touchend", (e) => {
        if (!dialog()?.open) return;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
</script>

<style>
    .gallery-grid {
        columns: 1;
        column-gap: var(--spacing-md);
        margin-top: var(--spacing-xl);
    }

    @media (min-width: 640px) {
        .gallery-grid {
            columns: 2;
        }
    }

    @media (min-width: 1024px) {
        .gallery-grid {
            columns: 3;
        }
    }

    .gallery-item {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: var(--spacing-md);
        break-inside: avoid;
        overflow: hidden;
        cursor: zoom-in;
        border: 1px solid var(--glass-border);
    }

    .gallery-item img {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.4s ease;
    }

    .gallery-item:hover img {
        transform: scale(1.04);
    }

    .lightbox {
        width: 100vw;
        max-width: 100vw;
        height: 100dvh;
        max-height: 100dvh;
        padding: var(--spacing-md);
        border: none;
        background: rgba(0, 0, 0, 0.85);
        place-items: center;
    }

    .lightbox[open] {
        display: grid;
    }

    .lightbox img {
        max-width: 100%;
        max-height: calc(100dvh - 2 * var(--spacing-md));
        object-fit: contain;
        border-radius: 12px;
    }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 3rem;
        height: 3rem;
        padding: 0;
        display: grid;
        place-items: center;
        color: #fff;
        background: rgba(0, 0, 0, 0.55);
        border: 2px solid rgba(255, 255, 255, 0.85);
        border-radius: 50%;
        cursor: pointer;
        transition: background-color 0.15s;
    }

    .lightbox-nav:hover,
    .lightbox-close:hover {
        background: rgba(0, 0, 0, 0.8);
    }

    .lightbox-prev {
        left: var(--spacing-md);
    }

    .lightbox-next {
        right: var(--spacing-md);
    }

    .lightbox-close {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        display: grid;
        place-items: center;
        color: #fff;
        background: rgba(0, 0, 0, 0.55);
        border: 2px solid rgba(255, 255, 255, 0.85);
        border-radius: 50%;
        cursor: pointer;
        transition: background-color 0.15s;
    }
</style>
