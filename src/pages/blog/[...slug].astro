---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}

const post = Astro.props;
---

<Layout title={post.data.title}>
    <Header />
    <main class="post-page">
        <div class="container">
            <nav class="breadcrumb">
                <a href={`${import.meta.env.BASE_URL}/blog`} class="btn">← Volver al blog</a>
            </nav>
            <article class="post-container fade-in-up">
            <header class="post-header">
                <div class="meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {
                            post.data.pubDate.toLocaleDateString("es-ES", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </time>
                </div>
                <h1 class="page-title">{post.data.title}</h1>
                <p class="page-subtitle">{post.data.description}</p>
            </header>

            <div class="post-content" set:html={post.data.content} />
        </article>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .post-page {
        padding-top: calc(var(--header-height) + 3rem);
        min-height: 80vh;
        background-color: var(--color-bg);
        padding-bottom: var(--section-padding);
    }

    .breadcrumb {
        margin-bottom: var(--spacing-sm);
    }

    .breadcrumb a:hover {
        opacity: 0.8;
    }

    .post-container {
        max-width: 800px;
        margin: 0 auto;
        background: transparent;
    }

    .post-header {
        margin-bottom: var(--spacing-md);
        padding-bottom: var(--spacing-sm);
    }
    
    .meta {
        display: flex;
        gap: var(--spacing-md);
        color: var(--color-text-light);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .tags {
        display: flex;
        gap: var(--spacing-sm);
    }

    .post-content {
        line-height: 1.8;
        font-size: 1.15rem;
        color: var(--color-text);
        letter-spacing: -0.01em;
    }

    /* Markdown Content Styling */
    .post-content :global(h1),
    .post-content :global(h2),
    .post-content :global(h3) {
        color: var(--color-primary);
        margin-top: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
        letter-spacing: -0.05em;
        font-weight: 700;
    }
    
    .post-content :global(h2) {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
    }

    .post-content :global(p) {
        margin-bottom: var(--spacing-md);
        color: var(--color-text);
    }

    .post-content :global(ul) {
        list-style: disc;
        margin-left: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }
    
    .post-content :global(strong) {
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .post-container {
            padding: 0;
        }
    }
</style>
