---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BrandCard from "../components/BrandCard.astro";
import { getCollection } from "astro:content";

const marcas = (await getCollection("brands")).sort((a, b) => {
    // If priority is not defined, sort by id to maintain consistency
    if (a.data.priority === undefined && b.data.priority === undefined) {
        return a.id.localeCompare(b.id);
    }
    if (a.data.priority === undefined) return 1;
    if (b.data.priority === undefined) return -1;
    // Sort by priority (higher numbers first)
    return b.data.priority - a.data.priority;
});
---

<Layout
	title="Nuestras Marcas | Farmacia Ortopedia Albiñana"
	description="Trabajamos con las mejores marcas de parafarmacia, cosmética y Ortopedia para garantizarte los mejores resultados."
>
	<Header />
	<main>
		<section class="section-full">
			<div class="container">
				<h1 class="page-title">Nuestras Marcas</h1>
				<p class="page-subtitle">
					Conoce las marcas de productos que ofrecemos en Farmacia
					Albiñana
				</p>

				<div class="grid-brands">
					{
						marcas.map((marca) => (
							<BrandCard
								id={marca.id}
								imagen={marca.data.imagen}
							/>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
