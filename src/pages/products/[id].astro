---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    const products = await getCollection("ofertas");
    return products.map((product) => ({
        params: { id: product.id },
        props: product,
    }));
}

const product = Astro.props;
const { title, description, price, discountPrice, offerEnds, content, imagenes } = product.data;

const mainImage = imagenes?.[0];
const galleryImages = imagenes?.slice(1) ?? [];

const formattedOfferEnds = offerEnds
    ? offerEnds.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
    : null;

const savings = discountPrice ? (price - discountPrice).toFixed(2) : null;
const savingsPercent = discountPrice ? Math.round(((price - discountPrice) / price) * 100) : null;
---

<Layout title={`${title} | Farmacia Albiñana`}>
    <Header />
    <main class="product-detail-page">
        <div class="container">
            <nav class="breadcrumb">
                <a href={`${import.meta.env.BASE_URL}/products`} class="btn">← Volver a ofertas</a>
            </nav>

            <div class="product-layout fade-in-up">
                <!-- Galería de imágenes -->
                <div class="product-gallery">
                    {mainImage ? (
                        <div class="main-image-wrap">
                            <img
                                src={`${import.meta.env.BASE_URL}${mainImage}`}
                                alt={title}
                                class="main-image"
                                id="main-product-image"
                            />
                            {savingsPercent && (
                                <span class="badge-discount">-{savingsPercent}%</span>
                            )}
                        </div>
                    ) : (
                        <div class="image-placeholder">
                            <span>Sin imagen</span>
                        </div>
                    )}

                    {galleryImages.length > 0 && (
                        <div class="thumbnails">
                            {imagenes?.map((src, i) => (
                                <button
                                    class={`thumb-btn ${i === 0 ? "active" : ""}`}
                                    data-src={`${import.meta.env.BASE_URL}${src}`}
                                    aria-label={`Imagen ${i + 1}`}
                                >
                                    <img src={`${import.meta.env.BASE_URL}${src}`} alt={`${title} imagen ${i + 1}`} />
                                </button>
                            ))}
                        </div>
                    )}
                </div>

                <!-- Info del producto -->
                <div class="product-info">
                    <h1 class="product-title page-title">{title}</h1>
                    <p class="product-description">{description}</p>

                    <div class="price-container">
                        {discountPrice ? (
                            <>
                                <span class="original-price">{price.toFixed(2)}€</span>
                                <span class="discount-price">{discountPrice.toFixed(2)}€</span>
                                <span class="savings-tag">Ahorras {savings}€</span>
                            </>
                        ) : (
                            <span class="price">{price.toFixed(2)}€</span>
                        )}
                    </div>

                    {formattedOfferEnds && (
                        <p class="offer-ends">
                            <span class="offer-icon">⏳</span> Válida hasta {formattedOfferEnds}
                        </p>
                    )}
                </div>
            </div>

            <!-- Descripción detallada -->
            {content && (
                <section class="product-body-section">
                    <h2 class="section-heading">Descripción del producto</h2>
                    <div class="product-body" set:html={content} />
                </section>
            )}
        </div>
    </main>
    <Footer />
</Layout>

<script>
    // Galería interactiva: cambiar imagen principal al hacer clic en miniatura
    const mainImg = document.getElementById("main-product-image") as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll<HTMLButtonElement>(".thumb-btn");

    thumbBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            if (mainImg) mainImg.src = btn.dataset.src ?? "";
            thumbBtns.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
        });
    });
</script>

<style>
    .product-detail-page {
        padding-top: calc(var(--header-height) + 3rem);
        min-height: 80vh;
        background-color: var(--color-surface);
        padding-bottom: var(--section-padding);
    }

    .breadcrumb {
        margin-bottom: var(--spacing-sm);
    }

    .breadcrumb a:hover {
        opacity: 0.8;
    }

    /* Layout principal */
    .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
        margin-bottom: 0;
    }

    /* Galería */
    .product-gallery {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .main-image-wrap {
        position: relative;
    }

    .main-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    .badge-discount {
        position: absolute;
        top: var(--spacing-md);
        left: var(--spacing-md);
        background: var(--color-danger);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
    }

    .image-placeholder {
        aspect-ratio: 1 / 1;
        background: #f0f0f0;
        border-radius: var(--border-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 1rem;
    }

    .thumbnails {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .thumb-btn {
        width: 72px;
        height: 72px;
        padding: 0;
        border: 2px solid transparent;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        background: none;
        transition: border-color var(--transition-fast);
    }

    .thumb-btn img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumb-btn.active,
    .thumb-btn:hover {
        border-color: var(--color-primary-dark);
    }

    /* Info */
    .product-info {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .product-title {
        color: var(--color-primary);
        line-height: 1.1;
        letter-spacing: -0.05em;
        font-weight: 700;
    }

    .product-description {
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        color: var(--color-text-light);
        line-height: 1.6;
        margin-bottom: var(--spacing-md);
    }

    .price-container {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-sm);
    }

    .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 0.95rem;
    }

    .discount-price {
        color: var(--color-danger);
        font-weight: 700;
        font-size: 1.5rem;
    }

    .price {
        color: var(--color-text);
        font-weight: 700;
        font-size: 1.5rem;
    }

    .savings-tag {
        background: var(--color-accent-soft);
        color: var(--color-accent);
        padding: 0.2rem 0.6rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-left: var(--spacing-sm);
        white-space: nowrap;
    }

    .offer-ends {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: var(--spacing-sm);
    }

    .offer-icon {
        margin-right: 0.2rem;
    }

    /* Descripción detallada */
    .product-body-section {
        margin-top: var(--spacing-md);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--glass-border);
    }

    .section-heading {
        font-size: 1.5rem;
        color: var(--color-primary);
        margin-bottom: var(--spacing-lg);
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .product-body {
        font-size: 1.1rem;
        color: var(--color-text);
        line-height: 1.8;
    }

    .product-body :global(p) {
        margin-bottom: var(--spacing-md);
    }

    .product-body :global(ul) {
        list-style: disc;
        margin-left: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }

    .product-body :global(li) {
        margin-bottom: var(--spacing-sm);
    }

    .product-body :global(strong) {
        color: var(--color-primary);
        font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .product-layout {
            grid-template-columns: 1fr;
        }

        .product-title {
            font-size: 1.6rem;
        }

        .price-discount,
        .price-normal {
            font-size: 1.8rem;
        }

        .product-body-section {
            padding: var(--spacing-md);
        }
    }
</style>
