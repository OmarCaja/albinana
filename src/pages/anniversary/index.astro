---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OfferCard from "../../components/OfferCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";
import { groupOffers, getFullOfferText } from "../../offers";
import { plannerWeeks } from "../../anniversaryPlanner";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const offers = groupOffers(
    await getCollection("offers", (offer) => offer.data.anniversary === true),
);

const isEn = lang === "en";
const locale = t("offers.locale") as string;
const weekday = (day: number) =>
    new Date(Date.UTC(2026, 10, day)).toLocaleDateString(locale, {
        weekday: "short",
        timeZone: "UTC",
    });
---

<Layout
    title={t("anniversary.meta.title")}
    description={t("anniversary.meta.description")}
>
    <Header />
    <main id="main-content">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title fade-in-up">{t("anniversary.title")}</h1>
                <p class="page-subtitle fade-in-up">{t("anniversary.subtitle")}</p>

                <nav class="anniversary-jump fade-in-up">
                    <a href="#planning" class="jump-pill">
                        {t("anniversary.planner.title")}
                    </a>
                    <a href="#offers" class="jump-pill jump-pill-offers">
                        {t("anniversary.offers.title")}
                        <span class="jump-count">{offers.length}</span>
                    </a>
                </nav>

                <section class="anniversary-block" id="planning">
                    <h2 class="anniversary-block-title fade-in-up">
                        {t("anniversary.planner.title")}
                    </h2>
                    <p class="anniversary-block-subtitle fade-in-up">
                        {t("anniversary.planner.subtitle")}
                    </p>
                    {
                        plannerWeeks.map((week) => (
                            <>
                                <h3 class="planner-week fade-in-up">
                                    {(
                                        t(
                                            `anniversary.planner.${week.key}`,
                                        ) as string
                                    )
                                        .split(" · ")
                                        .map((part, i) => (
                                            <>
                                                {i > 0 && (
                                                    <span class="planner-sep">
                                                        ·
                                                    </span>
                                                )}
                                                {part}
                                            </>
                                        ))}
                                </h3>
                                <div class="planner-grid">
                                    {week.days.map((d) => (
                                        <div
                                            class:list={[
                                                "planner-day glass-card fade-in-up",
                                                {
                                                    highlight: d.highlight,
                                                    closed: d.closed,
                                                },
                                            ]}
                                        >
                                            <div class="planner-date">
                                                <span class="planner-weekday">
                                                    {weekday(d.day)}
                                                </span>
                                                <span class="planner-number">
                                                    {d.day}
                                                </span>
                                            </div>
                                            <div class="card-content">
                                                <h4 class="planner-title">
                                                    {isEn ? d.title_en : d.title}
                                                </h4>
                                                <p class="planner-text">
                                                    {isEn ? d.text_en : d.text}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </>
                        ))
                    }
                    <h3 class="planner-week fade-in-up">
                        {t("anniversary.planner.dates.title")}
                    </h3>
                    <ul class="planner-dates fade-in-up">
                        <li>{t("anniversary.planner.dates.1")}</li>
                        <li>{t("anniversary.planner.dates.2")}</li>
                        <li>{t("anniversary.planner.dates.3")}</li>
                    </ul>
                    <div class="planner-thanks glass-card fade-in-up">
                        <p class="planner-thanks-title">
                            {t("anniversary.thanks")}
                        </p>
                        <p class="planner-thanks-signature">
                            {t("anniversary.planner.signature")}
                        </p>
                    </div>
                </section>

                <section class="anniversary-block" id="offers">
                    <h2 class="anniversary-block-title fade-in-up">
                        {t("anniversary.offers.title")}
                    </h2>
                    <p class="anniversary-block-subtitle fade-in-up">
                        {t("anniversary.offers.subtitle")}
                    </p>
                    <div class="offers-grid">
                        {
                            offers.map((offer: any) => {
                                const { title, description } =
                                    getFullOfferText(offer, t);
                                return (
                                    <OfferCard
                                        brand={offer.data.brand}
                                        title={title}
                                        description={description}
                                        startDate={offer.data.startDate}
                                        endDate={offer.data.endDate}
                                        isAllYear={false}
                                    />
                                );
                            })
                        }
                    </div>
                </section>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    :global(html) {
        scroll-behavior: smooth;
    }

    .anniversary-jump {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .jump-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.1rem;
        color: var(--color-text);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 999px;
        text-decoration: none;
        transition: transform 0.1s, border-color 0.15s;
    }

    .jump-pill:hover {
        border-color: var(--color-accent);
    }

    .jump-pill:active {
        transform: scale(0.96);
    }

    .jump-pill-offers {
        color: #fff;
        background: var(--color-primary);
        border-color: transparent;
    }

    .jump-count {
        padding: 0 0.5rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-primary);
        background: #fff;
        border-radius: 999px;
    }

    .anniversary-block {
        margin-top: var(--spacing-xl);
        scroll-margin-top: var(--header-height);
    }

    .anniversary-block-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--color-accent);
        letter-spacing: -0.04em;
        margin: 0;
    }

    .anniversary-block-subtitle {
        color: var(--color-text-light);
        font-size: 1.1rem;
        margin-top: var(--spacing-sm);
    }

    .planner-week {
        margin-top: var(--spacing-lg);
        color: var(--color-text);
    }

    .planner-sep {
        margin: 0 0.6em;
    }

    .planner-thanks {
        margin-top: var(--spacing-xl);
        padding: var(--spacing-lg) var(--spacing-md);
        text-align: center;
        border: 1px solid var(--color-accent-soft);
        background: linear-gradient(
            to bottom right,
            var(--glass-bg),
            rgba(0, 149, 200, 0.08)
        );
    }

    .planner-thanks-title {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.2;
        color: var(--color-accent);
    }

    .planner-thanks-signature {
        margin-top: var(--spacing-sm);
        color: var(--color-text-light);
        font-size: 1.1rem;
    }

    .planner-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: var(--spacing-md);
        margin-top: var(--spacing-md);
    }

    .planner-day {
        border: 1px solid var(--glass-border);
    }

    .planner-day.highlight {
        border-color: var(--color-accent);
        background: linear-gradient(
            to bottom right,
            var(--glass-bg),
            rgba(0, 149, 200, 0.08)
        );
    }

    .planner-day.closed {
        opacity: 0.6;
    }

    .planner-date {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.5rem 1.5rem;
        background: var(--color-accent-soft);
        border-bottom: 1px solid var(--glass-border);
        color: var(--color-accent);
        font-weight: 700;
    }

    .planner-weekday {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
    }

    .planner-number {
        font-size: 1.4rem;
    }

    .planner-title {
        font-size: 1.2rem;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .planner-text {
        color: var(--color-text);
        line-height: 1.5;
    }

    .planner-dates {
        margin: var(--spacing-sm) 0 0 1.25rem;
        line-height: 1.6;
    }

    .offers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
        gap: var(--spacing-lg);
        margin-top: var(--spacing-lg);
    }
</style>
