---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OfferCard from "../../components/OfferCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";
import { groupOffers, getFullOfferText } from "../../offers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const offers = groupOffers(
    await getCollection("offers", (offer) => offer.data.anniversary === true),
);
---

<Layout
    title={t("anniversary.meta.title")}
    description={t("anniversary.meta.description")}
>
    <Header />
    <main id="main-content">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title">{t("anniversary.title")}</h1>
                <p class="page-subtitle">{t("anniversary.subtitle")}</p>

                <section class="anniversary-block">
                    <h2 class="anniversary-block-title">
                        {t("anniversary.offers.title")}
                    </h2>
                    <p class="anniversary-block-subtitle">
                        {t("anniversary.offers.subtitle")}
                    </p>
                    <div class="offers-grid">
                        {
                            offers.map((offer: any) => {
                                const { title, description } =
                                    getFullOfferText(offer, t);
                                return (
                                    <OfferCard
                                        brand={offer.data.brand}
                                        title={title}
                                        description={description}
                                        startDate={offer.data.startDate}
                                        endDate={offer.data.endDate}
                                        isAllYear={false}
                                    />
                                );
                            })
                        }
                    </div>
                </section>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .anniversary-block {
        margin-top: var(--spacing-xl);
    }

    .anniversary-block-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--color-accent);
        letter-spacing: -0.04em;
        margin: 0;
    }

    .anniversary-block-subtitle {
        color: var(--color-text-light);
        font-size: 1.1rem;
        margin-top: var(--spacing-sm);
    }

    .offers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
        gap: var(--spacing-lg);
        margin-top: var(--spacing-lg);
    }
</style>
