---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BrandCard from "../../components/BrandCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const marcas = (await getCollection("brands")).sort((a, b) => {
    // If priority is not defined, sort by id to maintain consistency
    if (a.data.priority === undefined && b.data.priority === undefined) {
        return a.id.localeCompare(b.id);
    }
    if (a.data.priority === undefined) return 1;
    if (b.data.priority === undefined) return -1;
    // Sort by priority (lower numbers first - so 1 comes before 2)
    return a.data.priority - b.data.priority;
});
---

<Layout
	title={t("brands.meta.title")}
	description={t("brands.meta.description")}
>
	<Header />
	<main>
		<section class="section-full">
			<div class="container">
				<h1 class="page-title">{t("brands.title")}</h1>
				<p class="page-subtitle">
					{t("brands.subtitle")}
				</p>

				<div class="grid-brands">
					{
						marcas.map((marca) => (
							<BrandCard
								id={marca.id}
								imagen={marca.data.imagen}
							/>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>