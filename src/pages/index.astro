---
import { getLangFromUrl, useTranslations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Fidelidad from "../components/landing/Fidelidad.astro";

import Horario from "../components/landing/Horario.astro";
import About from "../components/landing/About.astro";
import Contact from "../components/landing/Contact.astro";
import Footer from "../components/Footer.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
	title={t("home.meta.title")}
	description={t("home.meta.description")}
>
	<Header />
	<main>
		<Hero lang={lang} />
		<Fidelidad lang={lang} />

		<Horario lang={lang} />
		<About lang={lang} />
		<Contact lang={lang} />
	</main>

	<Footer />
</Layout>
