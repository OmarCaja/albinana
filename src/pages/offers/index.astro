---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OfferCard from "../../components/OfferCard.astro";
import SearchBox from "../../components/SearchBox.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";
import { groupOffers, getFullOfferText } from "../../offers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const offers = await getCollection("offers");

const groupedOffers = groupOffers(
    offers.filter((offer) => !offer.data.anniversary),
);
---

<Layout
    title={t("offers.meta.title")}
    description={t("offers.meta.description")}
>
    <Header />
    <main id="main-content">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title">{t("offers.title")}</h1>
                <p class="page-subtitle">
                    {t("offers.subtitle")}
                    <br />
                    <span class="offer-note">
                        {t("offers.note")}
                    </span>
                </p>

                <SearchBox />
                <div class="brand-pills" id="brand-pills"></div>
                <div class="offers-grid" id="offers-container">
                    {
                        groupedOffers.map((offer: any) => {
                            const { title, description } =
                                getFullOfferText(offer, t);
                            const offerYear = offer.data.startDate.slice(0, 4);
                            const isAllYearFull =
                                offer.data.startDate.startsWith(
                                    `${offerYear}-01`,
                                ) &&
                                offer.data.endDate.startsWith(
                                    `${offerYear}-12`,
                                );

                            return (
                                <div
                                    class="offer-wrapper"
                                    data-brand={offer.data.brand}
                                    data-search={`${offer.data.brand} ${title} ${description}`}
                                    data-start={offer.data.startDate}
                                    data-end={offer.data.endDate}
                                    style="display: none;"
                                >
                                    <OfferCard
                                        brand={offer.data.brand}
                                        title={title}
                                        description={description}
                                        startDate={offer.data.startDate}
                                        endDate={offer.data.endDate}
                                        isAllYear={isAllYearFull}
                                    />
                                </div>
                            );
                        })
                    }
                </div>
                <script>
                    function filterOffersByDate() {
                        const today = new Date();
                        const year = today.getFullYear();
                        const month = String(today.getMonth() + 1).padStart(
                            2,
                            "0",
                        );
                        const day = String(today.getDate()).padStart(2, "0");
                        const todayStr = `${year}-${month}-${day}`;

                        const wrappers =
                            document.querySelectorAll(".offer-wrapper");

                        if (wrappers.length === 0) return;

                        wrappers.forEach((wrapper: any) => {
                            const start = wrapper.getAttribute("data-start");
                            const end = wrapper.getAttribute("data-end");
                            if (
                                start &&
                                end &&
                                todayStr >= start &&
                                todayStr <= end
                            ) {
                                // Set display to contents to make it part of the layout
                                // but keep the wrapper transparent
                                wrapper.style.display = "contents";
                            } else {
                                wrapper.style.display = "none";
                            }
                        });
                    }

                    // Pills only for brands that have an offer active today.
                    function buildBrandPills() {
                        const box = document.getElementById("brand-pills");
                        if (!box) return;
                        const brands = new Set<string>();
                        document
                            .querySelectorAll<HTMLElement>(".offer-wrapper")
                            .forEach((w) => {
                                if (w.style.display !== "none" && w.dataset.brand)
                                    brands.add(w.dataset.brand);
                            });
                        box.replaceChildren(
                            ...[...brands].sort().map((b) => {
                                const btn = document.createElement("button");
                                btn.type = "button";
                                btn.className = "brand-pill";
                                btn.textContent = b;
                                btn.dataset.brandPill = "";
                                btn.dataset.brand = b;
                                btn.setAttribute("aria-pressed", "false");
                                return btn;
                            }),
                        );
                    }

                    // Run only on astro:page-load — fires on both initial load AND navigations.
                    // Never call filterOffersByDate() inline here to avoid a double-paint
                    // on iOS Safari (inline call + page-load event = two renders per visit).
                    document.addEventListener(
                        "astro:page-load",
                        () => {
                            filterOffersByDate();
                            buildBrandPills();
                        },
                    );
                </script>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .offers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
        gap: var(--spacing-lg);
        margin-top: var(--spacing-xl);
    }
    .brand-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-lg);
    }
    .brand-pills :global(.brand-pill) {
        padding: 0.4rem 0.9rem;
        font: inherit;
        font-size: 0.9rem;
        color: var(--color-text);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 999px;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s, transform 0.15s;
    }
    .brand-pills :global(.brand-pill:active) {
        transform: scale(0.94);
    }
    .brand-pills :global(.brand-pill[aria-pressed="true"]) {
        color: #fff;
        background: var(--color-primary);
    }
    /* Visible cue that clicking again clears the filter */
    .brand-pills :global(.brand-pill[aria-pressed="true"])::after {
        content: " ✕";
        margin-left: 0.25rem;
        display: inline-block;
        animation: pill-x 0.2s ease-out;
    }
    @keyframes pill-x {
        from { opacity: 0; transform: scale(0.3); }
    }
</style>
