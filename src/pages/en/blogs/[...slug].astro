---
import Page from '../../blogs/[...slug].astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection("blogs");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}
---
<Page {...Astro.props} />
