---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import SearchBox from "../../components/SearchBox.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = (await getCollection("blogs")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// One pill per month that has posts, newest first (posts are already sorted).
const monthKey = (d: Date) => d.toISOString().slice(0, 7);
const months = [...new Set(posts.map((p) => monthKey(p.data.pubDate)))].map((key) => {
    const label = new Date(`${key}-01`).toLocaleDateString(t("blog.locale") as string, {
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    });
    return { key, label: label[0].toUpperCase() + label.slice(1) };
});
---

<Layout
    title={t("blog.meta.title")}
    description={t("blog.meta.description")}
>
    <Header />
    <main id="main-content" class="blog-page">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title fade-in-up">{t("blog.title")}</h1>
                <p class="page-subtitle fade-in-up">
                    {t("blog.subtitle")}
                </p>

                <SearchBox />
                <div class="brand-pills">
                    {
                        months.map((m) => (
                            <button
                                type="button"
                                class="brand-pill"
                                data-brand-pill
                                data-brand={m.key}
                                aria-pressed="false"
                            >
                                {m.label}
                            </button>
                        ))
                    }
                </div>
                <div class="grid-standard">
                    {
                        posts.map((post) => {
                            const en = lang === "en";
                            const text = [
                                en ? post.data.title_en || post.data.title : post.data.title,
                                en ? post.data.description_en || post.data.description : post.data.description,
                                en ? post.data.content_en || post.data.content : post.data.content,
                            ]
                                .join(" ")
                                .replace(/<[^>]+>/g, " ");
                            return (
                                <div
                                    data-search={text}
                                    data-brand={monthKey(post.data.pubDate)}
                                    style="display: contents"
                                >
                                    <BlogCard post={post} />
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
