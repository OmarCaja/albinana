---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blogs")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Blog de Salud y Bienestar | Farmacia ortopedia Albiñana"
    description="Consejos expertos sobre nutrición, dermocosmética, ortopedia y salud general. Tu fuente de información en Bétera."
>
    <Header />
    <main class="blog-page">
        <section class="section-full">
            <div class="container">
                <h1 class="page-title fade-in-up">Blog de salud</h1>
                <p class="page-subtitle fade-in-up">
                    Consejos, noticias y novedades para tu bienestar.
                </p>

                <div class="grid-standard">
                    {
                        posts.map((post) => (
                            <article class="blog-card glass-card fade-in-up">
                                <a href={`/blogs/${post.id}`}>
                                    <div class="card-content">
                                        <div class="card-meta">
                                            <time
                                                datetime={post.data.pubDate.toISOString()}
                                            >
                                                {post.data.pubDate.toLocaleDateString(
                                                    "es-ES",
                                                    {
                                                        year: "numeric",
                                                        month: "long",
                                                        day: "numeric",
                                                    },
                                                )}
                                            </time>
                                        </div>
                                        <h2 class="card-title">
                                            {post.data.title}
                                        </h2>
                                        <p class="card-desc">
                                            {post.data.description}
                                        </p>
                                        <span class="btn">Leer más &rarr;</span>
                                    </div>
                                </a>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .blog-page {
        min-height: 80vh;
        background-color: var(--color-bg);
    }

    .blog-card {
        padding: 0;
    }

    .blog-card a {
        display: flex;
        flex-direction: column;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .card-content {
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: var(--spacing-md);
    }

    .card-meta {
        font-size: 0.8rem;
        color: var(--color-primary);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .card-title {
        font-size: 1.5rem;
        color: var(--color-primary);
        letter-spacing: -0.04em;
        line-height: 1.1;
        font-weight: 800;
        margin: 0;
    }

    .card-desc {
        color: var(--color-text-light);
        line-height: 1.6;
        font-size: 1rem;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        width: fit-content;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--color-primary);
    }
</style>
